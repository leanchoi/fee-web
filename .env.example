# Configuración de la Fundación Educativa Esquel
# Copiar a `.env` y completar. `.env` está en .gitignore: nunca se versiona.

# --- Base de datos -----------------------------------------------------------
# Ruta del archivo SQLite, relativa a prisma/.
# Usar archivos distintos para desarrollo y producción.
DATABASE_URL="file:./dev.db"

# --- Sesiones (obligatorio en producción) ------------------------------------
# Firma las cookies de la intranet. Mínimo 32 caracteres.
# Generar con:  openssl rand -hex 32
# Si falta en producción, la aplicación se niega a autenticar en lugar de
# usar un secreto conocido. Cambiarla invalida todas las sesiones abiertas.
SESSION_SECRET=""

# --- Administrador principal -------------------------------------------------
# Sin estas variables el login maestro queda deshabilitado y sólo se puede
# entrar con usuarios de la base. No existe contraseña por defecto.
ADMIN_EMAIL="admin@fundacioneducativaesquel.edu.ar"

# Preferido: hash generado con `node scripts/hash-password.mjs "<contraseña>"`.
ADMIN_PASSWORD_HASH=""

# Alternativa más simple (contraseña en texto plano en el entorno).
# Se ignora si ADMIN_PASSWORD_HASH está definida.
# ADMIN_PASSWORD=""

# --- Sitio -------------------------------------------------------------------
# URL pública canónica. Se usa en metadatos, sitemap y datos estructurados.
NEXT_PUBLIC_SITE_URL="https://www.fundacioneducativaesquel.edu.ar"

# --- Integraciones opcionales ------------------------------------------------
# Webhook de Google Apps Script para replicar inscripciones y consultas
# en una planilla. Si está vacío, sólo se guarda en la base de datos.
GOOGLE_SHEET_WEBHOOK_URL=""
